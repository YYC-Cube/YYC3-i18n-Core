{
  "name": "@yyc3/i18n-core",
  "version": "3.4.0",
  "description": "🌐 YYC³ Production-Ready Internationalization (i18n) Framework - High-performance, plugin-based, zero-dependency i18n solution for TypeScript/JavaScript applications",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "typescript",
    "lru-cache",
    "plugin-system",
    "rtl",
    "lit",
    "web-components",
    "yyc3",
    "chinese-i18n",
    "chinese-localization",
    "中文国际化",
    "中文本地化",
    "react-i18n-alternative",
    "vue-i18n-alternative",
    "zero-dependencies",
    "enterprise-i18n",
    "next-i18n",
    "nuxt-i18n",
    "icu-messageformat",
    "mcp",
    "ai-translation",
    "quality-estimation",
    "ast-extraction"
  ],
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-i18n-Core.git"
  },
  "homepage": "https://github.com/YYC-Cube/YYC3-i18n-Core#readme",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-i18n-Core/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cache": {
      "import": "./dist/lib/cache.js",
      "types": "./dist/lib/cache.d.ts"
    },
    "./plugins": {
      "import": "./dist/lib/plugins/index.js",
      "types": "./dist/lib/plugins/index.d.ts"
    },
    "./icu": {
      "import": "./dist/lib/icu/parser.js",
      "types": "./dist/lib/icu/parser.d.ts"
    },
    "./ai": {
      "import": "./dist/lib/ai/provider.js",
      "types": "./dist/lib/ai/provider.d.ts"
    },
    "./mcp": {
      "import": "./dist/lib/mcp/server.js",
      "types": "./dist/lib/mcp/server.d.ts"
    },
    "./ota": {
      "import": "./dist/lib/ota/index.js",
      "types": "./dist/lib/ota/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "skills/",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "size": "size-limit",
    "audit:headers": "node scripts/header-footer-check.mjs",
    "audit:contract": "node scripts/exports-contract-check.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run audit:headers && npm run audit:contract && npm run size",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.2.0",
    "rollup": "^4.20.0",
    "size-limit": "^14.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "95 kB"
    }
  ],
  "sideEffects": false,
  "type": "module"
}