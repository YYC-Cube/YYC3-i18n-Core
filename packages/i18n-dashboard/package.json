{
  "name": "@yyc3/i18n-dashboard",
  "version": "0.1.0",
  "description": "Health dashboard React components for @yyc3/i18n-core — performance, coverage, OTA sync and audit panels",
  "keywords": [
    "i18n",
    "dashboard",
    "observability",
    "react",
    "internationalization",
    "metrics",
    "yyc3"
  ],
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-i18n-Core.git",
    "directory": "packages/i18n-dashboard"
  },
  "homepage": "https://github.com/YYC-Cube/YYC3-i18n-Core#readme",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-i18n-Core/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
